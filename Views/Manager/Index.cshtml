@model IEnumerable<WebApplication57.Models.Manager>

<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Action</th>
          
        </tr>
    </thead>
    <tbody>
       @foreach(var item in Model){
            <tr>
                <th >@item.Id</th>
                <td>@item.Name</td>
                <td> <a asp-controller="Manager" asp-action="Edit" asp-route-id="@item.Id">Edit</a>   </td>
                <td> <a asp-controller="Manager" asp-action="Delete" asp-route-id="@item.Id">Delete</a>   </td>
            </tr>
       }
       
    </tbody>
</table>

