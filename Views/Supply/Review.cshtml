@{
}
@model List<Offer>

<h2>Review Supply Request</h2>

<table class="table table-bordered">

    <tr>
        <th>Category</th>
        <th>Supplier</th>
        <th>Offer</th>
        <th>Quantity</th>
        <th>Unit Price</th>
        <th>Total Price</th>
    </tr>

    @foreach (var offer in Model)
    {
        <tr>
            <td>@offer.Category</td>
            <td>@offer.SupplierName</td>
            <td>@offer.OfferName</td>
            <td>@offer.Quantity</td>
            <td>@offer.UnitPrice JD</td>
            <td>@(offer.Quantity * offer.UnitPrice) JD</td>
        </tr>
    }

</table>

<h4>Total: @ViewBag.Total JD</h4>

<h4>Discount: @ViewBag.DiscountPercentage %</h4>

<h4>Discount Amount: @ViewBag.DiscountAmount JD</h4>

<h3>Final Total: @ViewBag.FinalTotal JD</h3>

<a href="@Url.Action("Index", "Supply")" class="btn btn-primary">
    Back to Offers
</a>